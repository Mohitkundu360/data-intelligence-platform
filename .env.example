# --- Infrastructure ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dataintel
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000

# --- AI planner / extractor (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Search provider (Brave Search API) ---
BRAVE_API_KEY=

# --- Collection policy ---
# Identify yourself honestly; sites can contact you. Put a real contact here.
USER_AGENT=DataIntelBot/0.1 (+mailto:you@example.com)
PER_DOMAIN_DELAY_SECONDS=1.0
MAX_PAGES_PER_WORKFLOW=40

# --- Development ---
# true = use synthetic fixture data (no API keys, no network). Never enable in production.
DEV_FIXTURES=true
